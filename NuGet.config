<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows plugin builds restore Microsoft.Windows.CppWinRT during CMake configure
  (permission_handler_windows). NuGet discovers configuration by walking up from
  the build directory, so this file guarantees the public feed is available even
  on machines whose user-level config lists no package sources.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
